---
import config from '../data/config.json';
const { akad, reception } = config.event;
---

<section class="py-16 px-4 bg-[#edf5f9]">
  <div class="max-w-5xl mx-auto fade-in-section">
    <div class="grid md:grid-cols-2 gap-8 items-stretch">
      
      <!-- Akad -->
      <div class="bg-white/70 backdrop-blur-sm p-6 rounded-3xl shadow-soft border border-[#dcebf3]">
        <h3 class="text-2xl font-serif text-[#2c3e50] flex items-center gap-3">
          <i class="fas fa-ring text-[#eca3b1]"></i> Akad Nikah
        </h3>
        <p class="mt-2 text-[#2c3e50]"><i class="far fa-clock mr-2"></i> {akad.time}</p>
        
        <div class="mt-3 h-40 rounded-xl overflow-hidden map-container bg-[#e1eef4]">
          <!-- Google Maps iframe, assume config provides src link -->
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d126920.24009712711!2d106.75885233267253!3d-6.229746497217961!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e69f3e945e34b9d%3A0x100c5e82dd4b820!2sJakarta%2C%20Daerah%20Khusus%20Ibukota%20Jakarta!5e0!3m2!1sid!2sid!4v1700000000000" 
            width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy">
          </iframe>
        </div>
        
        <p class="mt-3 text-sm font-medium text-[#2c3e50]">{akad.venue}</p>
        <p class="mt-1 text-xs text-[#5a728a]"><i class="fas fa-map-pin mr-1"></i> {akad.address}</p>
        
        <a href={akad.mapsLink} target="_blank" rel="noopener noreferrer" class="mt-4 block text-center w-full bg-[#f2b6c1] hover:bg-[#eca3b1] text-white font-medium py-2.5 px-4 rounded-xl transition-colors shadow-md text-sm">
          Buka Google Maps
        </a>
      </div>
      
      <!-- Resepsi -->
      <div class="bg-white/70 backdrop-blur-sm p-6 rounded-3xl shadow-soft border border-[#dcebf3]">
        <h3 class="text-2xl font-serif text-[#2c3e50] flex items-center gap-3">
          <i class="fas fa-champagne-glasses text-[#eca3b1]"></i> Resepsi
        </h3>
        <p class="mt-2 text-[#2c3e50]"><i class="far fa-clock mr-2"></i> {reception.time}</p>
        
        <div class="mt-3 h-40 rounded-xl overflow-hidden map-container bg-[#e1eef4]">
          <!-- Google Maps iframe -->
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d126920.24009712711!2d106.75885233267253!3d-6.229746497217961!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e69f3e945e34b9d%3A0x100c5e82dd4b820!2sJakarta%2C%20Daerah%20Khusus%20Ibukota%20Jakarta!5e0!3m2!1sid!2sid!4v1700000000000" 
            width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy">
          </iframe>
        </div>
        
        <p class="mt-3 text-sm font-medium text-[#2c3e50]">{reception.venue}</p>
        <p class="mt-1 text-xs text-[#5a728a]"><i class="fas fa-map-pin mr-1"></i> {reception.address}</p>

        <a href={reception.mapsLink} target="_blank" rel="noopener noreferrer" class="mt-4 block text-center w-full bg-[#f2b6c1] hover:bg-[#eca3b1] text-white font-medium py-2.5 px-4 rounded-xl transition-colors shadow-md text-sm">
          Buka Google Maps
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  .map-container {
    filter: grayscale(0.1) sepia(0.05);
  }
</style>
